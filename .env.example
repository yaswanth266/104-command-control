# 104 Central Command Centre — local configuration
# Copy to `ccc.env` and fill in. NEVER commit the filled-in file.
#
# On the server this lives at /opt/ccc/ccc.env with mode 0600 and is loaded by
# systemd via EnvironmentFile. The real values are on cct.bhspl.in only.

CCC_DB_HOST=127.0.0.1
CCC_DB_USER=ccc
CCC_DB_PW=change-me
CCC_DB_NAME=ccc

# Absolute path to the folder holding index.html (the SPA is served from here)
CCC_WEB=./web

# Signs the session token. Use a long random string; changing it logs everyone out.
CCC_SECRET=change-me-to-a-long-random-string
