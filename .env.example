# 104 Central Command Centre — local configuration
# Copy to `ccc.env` and fill in. NEVER commit the filled-in file.
#
# On the server this lives at /opt/ccc/ccc.env with mode 0600 and is loaded by
# systemd via EnvironmentFile. The real values are on cct.bhspl.in only.

CCC_DB_HOST=127.0.0.1
CCC_DB_USER=ccc
CCC_DB_PW=change-me
CCC_DB_NAME=ccc

# Absolute path to the folder holding index.html (the SPA is served from here)
CCC_WEB=./web

# Signs the session token. REQUIRED - the app refuses to start without a value
# at least 16 characters long. Use a long random string; changing it logs
# everyone out. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
CCC_SECRET=change-me-to-a-long-random-string

# How long a login session token stays valid, in seconds. Default: 12 hours.
CCC_TOKEN_TTL_SECONDS=43200

# Shared secret the 104 field-app/gov-EHR integration must send as the
# X-Intake-Key header on POST /intake. REQUIRED - without it /intake returns
# 503. Coordinate this value with whoever operates the field-app/EHR side.
CCC_INTAKE_KEY=change-me-to-a-long-random-string

# SLA tuning (minutes/hours). Defaults shown - only set to override.
# CCC_AT_RISK_MINUTES=60
# CCC_CRITICAL_MINUTES=15
# CCC_SLA_SWEEP_SECONDS=60
# CCC_RESOLVED_FOLLOWUP_HOURS=4
